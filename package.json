{
  "name": "maian-rescue-mobile",
  "version": "1.0.0",
  "scripts": {
    "dev:h5": "uni",
    "dev:preview": "bash scripts/dev-preview.sh",
    "test:preview": "python3 scripts/check-preview.py",
    "test:ui": "node scripts/check-assistant-ui.mjs",
    "test:agent": "node scripts/check-global-agent.mjs",
    "test:rescue-agent": "node scripts/check-rescue-agent.mjs",
    "test:workflows": "node scripts/check-agent-workflows.mjs",
    "test:inputs": "node scripts/check-agent-inputs.mjs",
    "test:business": "python3 scripts/check-business-flows.py",
    "build:ios": "uni build -p app-ios",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:layout": "node scripts/check-page-density.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4080420251103001",
    "@dcloudio/uni-app-plus": "3.0.0-4080420251103001",
    "@dcloudio/uni-components": "3.0.0-4080420251103001",
    "@dcloudio/uni-h5": "3.0.0-4080420251103001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4080420251103001",
    "@dcloudio/uni-ui": "^1.5.12",
    "leaflet": "^1.9.4",
    "marked": "^18.1.1",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-4080420251103001",
    "@dcloudio/uni-stacktracey": "3.0.0-4080420251103001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4080420251103001",
    "@types/leaflet": "^1.9.20",
    "@vue/runtime-core": "^3.4.21",
    "@vue/tsconfig": "^0.1.3",
    "sass": "^1.101.0",
    "typescript": "^4.9.4",
    "vite": "^5.2.8",
    "vitest": "^2.1.9",
    "vue-tsc": "^1.0.24"
  }
}
